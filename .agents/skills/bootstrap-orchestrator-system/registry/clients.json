{
  "about": "Client profiles for scripts/install.mjs. Each profile records how one client discovers role files, skills, routers and permissions, written against the official documentation listed in `docs` on `checkedOn`. Bootstrap re-checks the profile against the current documentation of every selected client and records any difference as an `overrides` entry in the answers file; the installer applies the overrides on top of the profile. A client without a profile is rendered by the agent under contracts/client-bindings.md.",
  "profiles": {
    "claude-code": {
      "label": "Claude Code",
      "docs": [
        "https://code.claude.com/docs/en/sub-agents",
        "https://code.claude.com/docs/en/skills",
        "https://code.claude.com/docs/en/settings",
        "https://code.claude.com/docs/en/memory"
      ],
      "checkedOn": "2026-10-24",
      "router": { "file": "CLAUDE.md", "import": "@AGENTS.md" },
      "scopedInstructions": null,
      "agents": { "dir": ".claude/agents", "format": "claude" },
      "skills": { "dir": ".claude/skills", "manualOnly": { "frontmatter": { "disable-model-invocation": true } } },
      "alsoDiscovers": [],
      "tools": {
        "read": ["Read"],
        "search": ["Grep", "Glob"],
        "write": ["Edit", "Write"],
        "terminal": ["Bash"],
        "question": ["AskUserQuestion"],
        "runtime": ["Bash"],
        "delegate": ["Agent", "SendMessage"]
      },
      "routes": {
        "default": "skill",
        "nativeStart": "start a new session with `claude --agent {name}`"
      },
      "delegation": {
        "native": "Start a delegate with the `Agent` tool, `subagent_type` set to the role's native name below, and the prompt the step gives. The delegate runs in its own context and only its final report returns. Resume it with `SendMessage` addressed to the agent id the `Agent` call returned (`delegate_id`).",
        "generalPurpose": "general-purpose",
        "resume": true,
        "subprocess": "claude -p"
      },
      "permissions": { "format": "claude-settings", "file": ".claude/settings.json" }
    },
    "codex": {
      "label": "Codex",
      "docs": [
        "https://developers.openai.com/codex/subagents",
